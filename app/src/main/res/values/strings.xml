    <!-- ===== 设置页 ===== -->
    <string name="settings_permission_section">权限状态</string>
    <string name="settings_permission_hint">核心功能只需要「修改系统设置」。其它权限按需开启；缺少时相关功能会给出引导，不会影响锁定和翻转。</string>
    <string name="settings_perm_write_title">修改系统设置</string>
    <string name="settings_perm_write_desc">锁定 / 翻转 / 跟随系统的核心权限，免 root 方案完全依赖它。</string>
    <string name="settings_perm_overlay_title">悬浮窗</string>
    <string name="settings_perm_overlay_desc">显示悬浮球，不离开当前应用就能翻转。</string>
    <string name="settings_perm_notification_title">通知</string>
    <string name="settings_perm_notification_desc">悬浮球运行时需要常驻通知；Android 13 起需要手动允许。</string>
    <string name="settings_perm_accessibility_title">无障碍服务</string>
    <string name="settings_perm_accessibility_desc">只读取当前前台应用的包名，用于按应用规则；不读取屏幕内容，不获取文字。</string>
    <string name="settings_perm_secure_title">高级档：WRITE_SECURE_SETTINGS</string>
    <string name="settings_perm_secure_desc">可选。下面的能力只能由电脑 adb 执行，App 内没有开关；没有它不影响锁定、翻转等主要功能。</string>
    <string name="settings_perm_secure_copied">命令已复制</string>
    <string name="settings_secure_honest_note">以上命令都需要在电脑上执行一次，App 无法代替你完成——系统没有提供公开接口。授予 WRITE_SECURE_SETTINGS 也不够，所以这里不提供任何开关。</string>
    <string name="settings_secure_cmd_global_label">① 最推荐：全局让系统忽略应用自己请求的方向（已核实）</string>
    <string name="settings_secure_cmd_global_note">改成 false 即关闭；查询当前值用 adb shell cmd window get-ignore-orientation-request。重启后仍然保留。</string>
    <string name="settings_secure_cmd_force_label">② 更彻底：让系统无条件采用你设定的方向（已核实）</string>
    <string name="settings_secure_cmd_force_note">改成 disabled 即关闭。代价：被强制的应用可能出现黑边（letterbox）而不是铺满屏幕。</string>
    <string name="settings_secure_cmd_app_label">③ 可选：只对某一个应用生效（把 &lt;包名&gt; 换成目标应用，例如 com.example.videoapp；未完全核实）</string>
    <string name="settings_secure_cmd_app_note">只对指定应用生效；取消用 adb shell am compat disable &lt;同上&gt; &lt;包名&gt;。执行后系统默认会重启该应用。该命令来自官方大屏兼容模式文档（未能独立核实原文），请在执行前自行确认。</string>
    <string name="settings_device_section">设备</string>
    <string name="settings_natural_landscape_title">自然方向为横屏</string>
    <string name="settings_natural_landscape_desc">平板通常为横屏。如果横竖判断反了，切换这个开关。</string>
    <string name="settings_overlay_title">悬浮球</string>
    <string name="settings_overlay_desc">开启后显示一个可拖动的悬浮球，不离开当前应用就能翻转（需要悬浮窗权限）。</string>
    <string name="settings_overlay_need_permission">需要先授予悬浮窗权限</string>
    <string name="settings_tips_section">快速入口</string>
    <string name="settings_tip_tile">快速设置磁贴：下拉通知栏 → 编辑 → 把「屏幕方向控制」拖进快捷磁贴，躺姿下一键锁定或者翻转。</string>
    <string name="settings_tip_overlay">悬浮球：不离开当前应用也能锁定 / 翻转，适合全屏看视频。</string>
    <string name="settings_about_section">关于与免责声明</string>
    <string name="settings_about_version">版本 %1$s</string>
    <string name="settings_about_limitation_title">免 root 的边界</string>
    <string name="settings_about_limitation_body">本应用通过修改系统旋转设置生效。若某个应用在代码里硬编码了屏幕方向（例如强制竖屏的视频、部分游戏），系统旋转设置无法覆盖它——这是 Android 的设计，不是本应用故障。想让系统忽略应用自身的方向请求，需要在电脑上执行一次 adb 命令（见上方「高级档」卡片），App 自己做不到。</string>
    <string name="settings_about_privacy">隐私：不联网，不上传任何数据；无障碍服务只读取前台应用包名。</string>

    <!-- ===== 高级档 adb 命令（可整行复制；结构见 SettingsScreen 高级档卡片） ===== -->
    <string name="adb_cmd_set_ignore_orientation_request">adb shell cmd window set-ignore-orientation-request true</string>
    <string name="adb_cmd_fixed_to_user_rotation">adb shell cmd window fixed-to-user-rotation enabled</string>
    <string name="adb_ignore_orientation_request">adb shell am compat enable OVERRIDE_ENABLE_COMPAT_IGNORE_REQUESTED_ORIENTATION com.example.videoapp</string>

