# 统一换行，避免 Windows/Linux 混合提交把 gradlew 弄坏
* text=auto

# Unix 上直接 ./gradlew 执行，必须是 LF（CI 会用到）
gradlew text eol=lf
gradle/wrapper/gradle-wrapper.properties text eol=lf

# Windows 批处理必须是 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制（不做任何换行转换）
*.jar binary
*.apk binary
*.aab binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.docx binary
*.zip binary
