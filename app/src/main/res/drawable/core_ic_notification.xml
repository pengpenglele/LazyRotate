<?xml version="1.0" encoding="utf-8"?>
<!--
  通知小图标（core 模块）。
  硬性要求：纯白、单色剪影、只有 alpha 有意义（系统会把它当遮罩渲染，彩色/灰色都会被忽略）。
  所以这里只有 #FFFFFFFF，没有任何灰色或渐变。

  几何与 core_ic_tile.xml 完全一致（同一套圆心/半径/flags），只是颜色改成纯白：
    A 的 large-arc-flag=1、sweep-flag=0，圆心才是 (12,12.5)；写成 sweep=1 会选到 (4.5,5) 并跑出画布。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#00000000"
        android:pathData="M4.5,12.5 A7.5,7.5 0 1 0 12,5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="2" />

    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.6,5 L12.8,1.9 L12.8,8.1 Z" />
</vector>
